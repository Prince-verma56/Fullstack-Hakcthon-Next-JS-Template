{
  "name": "fullstack-template",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "echo \"E2E tests not yet configured (Playwright). See tests/e2e/\"",
    "test:ai": "vitest run tests/ai",
    "setup": "tsx scripts/setup.ts",
    "doctor": "tsx scripts/doctor.ts",
    "audit:project": "npm run typecheck && npm run lint && npm run test",
    "demo": "npm run db:seed && echo \"Demo data seeded. Run npm run dev to view.\"",
    "reset": "npx prisma migrate reset --force",
    "generate": "npx prisma generate",
    "infra:open": "tsx scripts/infra-open.ts",
    "infra:up": "docker compose --env-file .env -f docker/compose.dev.yaml up -d --wait && npm run infra:open",
    "infra:down": "docker compose --env-file .env -f docker/compose.dev.yaml down",
    "infra:reset": "docker compose --env-file .env -f docker/compose.dev.yaml down -v",
    "db:migrate": "npx prisma migrate dev",
    "db:seed": "npx prisma db seed",
    "db:studio": "npx prisma studio",
    "db:push": "npx prisma db push"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@clerk/nextjs": "^7.9.11",
    "@hookform/resolvers": "^5.9.1",
    "@prisma/adapter-pg": "^7.10.0",
    "@studio-freight/lenis": "^1.0.42",
    "@types/pg": "^8.23.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cn": "^0.4.0",
    "date-fns": "^4.4.0",
    "gsap": "^3.15.0",
    "input-otp": "^1.5.0",
    "lucide-react": "^1.52.0",
    "next": "16.3.8",
    "next-themes": "^0.4.6",
    "pg": "^8.23.1",
    "react": "19.2.8",
    "react-day-picker": "^10.0.2",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.89.0",
    "recharts": "^3.8.0",
    "shadcn": "^4.21.2",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@prisma/client": "^7.10.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "prisma": "^7.10.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
