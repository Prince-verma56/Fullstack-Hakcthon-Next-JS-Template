// Prisma Schema - Fullstack Hackathon Template
//
// This is the foundational schema. Domain-specific models
// (health, education, commerce) should be added when a specific
// problem statement requires them.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [vector]
}

/// Core user model. Extended by domain modules as needed.
model User {
  id            String    @id @default(cuid())
  clerkUserId   String    @unique
  email         String    @unique
  name          String?
  avatarUrl     String?
  role          String    @default("user")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  conversations Conversation[]
  memories      Memory[]
  documents     Document[]

  @@map("users")
}

// --- AI Core Models ---

model Conversation {
  id        String   @id @default(cuid())
  userId    String?
  channel   String   @default("text") // text, voice, agent
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  metadata  Json?

  messages  Message[]
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("conversations")
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  role           String       // user, assistant, system, tool
  content        String
  createdAt      DateTime     @default(now())
  sequence       Int          @default(0)
  metadata       Json?

  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, sequence])
  @@map("messages")
}

model Memory {
  id         String   @id @default(cuid())
  userId     String
  content    String
  sourceId   String?  // e.g., conversationId
  importance Int      @default(0)
  expiresAt  DateTime?
  metadata   Json?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("memories")
}

// --- RAG / Document Models ---

model Document {
  id             String          @id @default(cuid())
  userId         String?
  organizationId String?
  filename       String
  mimeType       String
  source         String?
  metadata       Json?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  chunks         DocumentChunk[]
  user           User?           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("documents")
}

model DocumentChunk {
  id         String   @id @default(cuid())
  documentId String
  content    String
  chunkIndex Int
  metadata   Json?
  
  // Note: Adjust the vector dimension based on your embedding model (e.g., 1536 for OpenAI)
  embedding  Unsupported("vector(1536)")?

  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@map("document_chunks")
}
